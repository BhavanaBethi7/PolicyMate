# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/PolicyMate

# Server Configuration
PORT=5000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here

# AI API Configuration (Groq is preferred - no rate limits!)
# Get free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# Optional: Fallback to OpenAI if Groq is not available
# Get OpenAI key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_your_openai_key_here

# Note: The system uses Groq by default (free, no rate limits)
# If GROQ_API_KEY is not set, it falls back to OPENAI_API_KEY
# At least one AI API key must be configured for eligibility checking to work
